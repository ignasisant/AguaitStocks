# yfinance needs no key. Fill these only if you later add these providers.
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info (free, no key).
EDGAR_USER_AGENT="stocks-toolkit your-email@example.com"

# --- Alert delivery (stocks alerts --deliver). Unset channels are skipped. ---
# Telegram: create a bot with @BotFather, then message it once to get your chat id.
# The same bot powers per-user notifications (stocks digest/alerts --all-users
# and the Profile page linking flow); TELEGRAM_CHAT_ID is only the single-user
# CLI channel. Never configure a webhook on this bot — linking polls getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=

# Multi-user notification cron (GitHub Actions) — set as repo secrets, not here:
#   STOCKS_STORAGE_* (bucket creds), TELEGRAM_BOT_TOKEN,
#   CHAT_ENC_KEY (= Streamlit [chat] enc_key, for BYOK digest highlights),
#   FREE_LLM_GROQ / FREE_LLM_CEREBRAS / FREE_LLM_OPENROUTER (free-chain fallback).

# Email over SMTP (e.g. Gmail app password). ALERT_EMAIL_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
