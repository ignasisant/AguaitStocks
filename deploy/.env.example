# Copy to deploy/.env (git-ignored) on the VM and fill in.

# Public hostname via sslip.io magic DNS — no signup, no token. It resolves
# <ip-with-dashes>.sslip.io (or <ip-with-dots>.sslip.io) straight to that IP.
# Use your VM's public IP with dots replaced by dashes, e.g. for 152.70.1.2:
SITE_ADDRESS=152-70-1-2.sslip.io
