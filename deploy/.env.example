# Copy to deploy/.env (git-ignored) on the VM and fill in.

# Public hostname = your DuckDNS subdomain. Register a free one at
# https://www.duckdns.org (sign in with Google/GitHub), pick a name, and it
# becomes <name>.duckdns.org.
SITE_ADDRESS=aguait-stocks.duckdns.org

# Just the subdomain label (no .duckdns.org) and your DuckDNS token (shown at
# the top of the duckdns.org page after signing in — one token per account).
DUCKDNS_SUBDOMAIN=aguait-stocks
DUCKDNS_TOKEN=
