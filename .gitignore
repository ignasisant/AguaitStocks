# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Mirrored company logos (generated at runtime, served same-origin)
/src/stocks/web/static/logos/

# Cached price data (keep the folder, ignore its contents)
/data/*.csv
/data/statements/
/data/*.parquet

# Personal watchlist (holdings, favorites, alert levels) — the tracked
# template is watchlist.example.yaml
/watchlist.yaml

# Portfolio ledger (private holdings) + cached FX history
/data/portfolio.db
/data/portfolio.db.bak*
/data/fx_history.json

# FRED CSV and Eurostat HICP responses (stocks.data.macro) — a six-hour
# regenerable cache of public data, and the reason a page rerun costs no
# request; nothing in here is private and nothing in here is source
/data/macro/

# Learned Yahoo quoteType per symbol (stocks.data.funds) — a regenerable
# cache; the catalog in funds.py seeds the common funds without it
/data/quote_types.json
/data/last_import.json
# Daily counter for the keyless assistant's global allowance (runtime state).
/data/free_llm_global.json

# Production log snapshots (`stocks logs export`) — they carry account slugs
# and user-typed queries, and they are a copy of Cloud Logging, not source.
/data/logs/

# Per-account data (watchlists, ledgers, prefs — private)
/data/users/
/data/prefs.json
/data/chat.json
/data/daily_action.json
/data/chat_memory.db
/data/tg_updates/

# Notebooks
.ipynb_checkpoints/

# Tool caches
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store

# Streamlit secrets (never commit) — .bak* covers rotate-script backups
.streamlit/secrets.toml
.streamlit/secrets.toml.bak*

# VM deploy secrets (Oracle + Cloudflare Tunnel) — never commit
/deploy/.env
/deploy/secrets.toml

# Agent tooling. Only the per-machine bits: the streamlit skill under
# .claude/skills/ is a symlink into .venv and settings.local.json is personal,
# but the project's own skills there are versioned like any other repo tooling.
/.claude/settings.local.json
/.claude/skills/developing-with-streamlit
/.agents/
.notify_secrets.env
/data/feedback/
/data/chat.json
