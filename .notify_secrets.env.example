# Notification-cron secrets — copy to .notify_secrets.env (git-ignored), paste
# values, then run:  ./scripts/setup_notify_secrets.sh
#
# Everything else (CHAT_ENC_KEY, FREE_LLM_*) is harvested automatically from
# .streamlit/secrets.toml — leave those out of this file.

# From @BotFather: /newbot -> token. Username is the bot's @handle (no @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Random string shared with the Cloudflare Worker's WEBHOOK_SECRET (see
# workers/telegram-webhook/README.md); used by
# `stocks telegram-chat --set-webhook <url>` when pointing the bot at the
# Worker. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Same R2/S3 credentials the Streamlit Cloud deploy uses ([storage] section in
# its secrets, or your Cloudflare R2 dashboard -> API tokens).
STOCKS_STORAGE_ENDPOINT_URL=
STOCKS_STORAGE_BUCKET=
STOCKS_STORAGE_ACCESS_KEY_ID=
STOCKS_STORAGE_SECRET_ACCESS_KEY=
